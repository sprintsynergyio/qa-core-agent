 "map": {
  "features": [
   {
    "name": "catalogue",
    "rules": [
     {
      "id": "R1",
      "text": "The home page lists products with a name, an image and a price.",
      "type": "behavior"
     },
     {
      "id": "R2",
      "text": "Typing a term in the search box and submitting shows only products whose name contains the term.",
      "type": "behavior"
     },
     {
      "id": "R3",
      "text": "The category filter narrows the list to products in the selected category.",
      "type": "behavior"
     },
     {
      "id": "R4",
      "text": "Sorting by price low to high orders the visible products by ascending price.",
      "type": "behavior"
     },
     {
      "id": "R5",
      "text": "Clicking a product opens its detail page showing the same name and price as the listing.",
      "type": "navigation"
     }
    ]
   },
   {
    "name": "cart",
    "rules": [
     {
      "id": "R6",
      "text": "Adding a product from its detail page increases the cart count shown in the header.",
      "type": "behavior"
     },
     {
      "id": "R7",
      "text": "The cart page lists each added product with quantity and line total.",
      "type": "behavior"
     },
     {
      "id": "R8",
      "text": "Changing a quantity on the cart page updates the line total.",
      "type": "behavior"
     },
     {
      "id": "R9",
      "text": "Removing a product from the cart removes its row and updates the total.",
      "type": "behavior"
     }
    ]
   },
   {
    "name": "account",
    "rules": [
     {
      "id": "R10",
      "text": "Login with a wrong password shows an error and the user stays on the login page.",
      "type": "behavior"
     },
     {
      "id": "R11",
      "text": "Registration with an already used email address is rejected with an error.",
      "type": "validation"
     },
     {
      "id": "R12",
      "text": "Submitting the registration form with an empty required field shows a required-field message.",
      "type": "validation"
     }
    ]
   },
   {
    "name": "contact",
    "rules": [
     {
      "id": "R13",
      "text": "The contact form rejects submission when the message field is empty and shows a validation message.",
      "type": "validation"
     },
     {
      "id": "R14",
      "text": "The contact form rejects an email address without an @ sign.",
      "type": "validation"
     }
    ]
   }
